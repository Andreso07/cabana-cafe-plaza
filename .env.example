# Base de datos. Local: el Postgres de Docker (ver README).
# Supabase: botón Connect > Direct > "Session pooler" (puerto 5432). No el Transaction pooler (6543).
DATABASE_URL=postgres://postgres:cabana_local@localhost:5433/cabana

# Clave del panel /admin (mínimo 10 caracteres)
ADMIN_USUARIO=cambia-este-usuario
ADMIN_PASSWORD=cambia-esta-clave

# Wompi: déjalas vacías para usar el modo de pago simulado.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# Google Calendar (opcional): las reservas de la web se anotan en el calendario del dueño.
# La cuenta de servicio es un JSON de Google Cloud (todo en una línea) y el ID es el del calendario
# compartido con esa cuenta («Hacer cambios en eventos»). Vacías: la web funciona sin Google.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
