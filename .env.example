# Base de datos. Local: el Postgres de Docker (ver README).
# Supabase: botón Connect > Direct > "Session pooler" (puerto 5432). No el Transaction pooler (6543).
DATABASE_URL=postgres://postgres:cabana_local@localhost:5433/cabana

# Clave del panel /admin (mínimo 10 caracteres)
ADMIN_PASSWORD=cambia-esta-clave

# Wompi: déjalas vacías para usar el modo de pago simulado.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
